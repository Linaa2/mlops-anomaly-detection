# ============================================================
# EXAMPLE — Copier en envs/.env.dev ou envs/.env.prod et remplir
# Usage dev : docker compose --env-file envs/.env.dev up
# ============================================================

ENV=dev  # dev | prod

# ── MLflow ────────────────────────────────────────────────────
# dev : http://mlflow:5000 (docker-compose DNS)
# prod : URI externe (ex: http://<host>:5000)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
# Nom du modèle dans le MLflow Model Registry (utilisé par l'API)
MLFLOW_MODEL_NAME=HydraulicConditionModel

# ── PostgreSQL (Airflow backend) ──────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=airflow

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_in_prod
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# ── FastAPI ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# Chemin local vers le modèle pkl (fallback si MLflow indisponible)
MODEL_PATH=models/model.pkl

# ── Webapp (Streamlit) ────────────────────────────────────────
API_URL=http://api:8000
STREAMLIT_SERVER_PORT=8501
# Chemin vers le JSON de métriques généré par l'entraînement
METRICS_PATH=reports/model_metrics.json

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_in_prod
PROMETHEUS_RETENTION=15d

# ── Chemins données (src/) ────────────────────────────────────
RAW_DIR=data/raw
RAW_CSV_PATH=data/raw/hydraulic_data.csv
PROCESSED_CSV_PATH=data/processed/hydraulic_clean.csv
INPUT_PATH=data/processed/hydraulic_clean.csv

# ── Hyperparamètres modèle ────────────────────────────────────
N_ESTIMATORS=100
TEST_SIZE=0.2
RANDOM_STATE=42
