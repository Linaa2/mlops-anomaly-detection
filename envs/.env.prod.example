# ============================================================
# PRODUCTION — Copy to envs/.env.prod and fill ALL values
# Usage : docker compose -f docker-compose.prod.yml --env-file envs/.env.prod up -d
#
# WARNING: Every variable here is REQUIRED (no defaults in prod).
# ============================================================

ENV=production

# ── Image tag (git short SHA, set by CD pipeline) ────────────
IMAGE_TAG=latest

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=hydraulic-anomaly-detector
# Separate DB for MLflow metadata (created automatically by PostgreSQL)
MLFLOW_DB=mlflow

# ── MinIO (artifact store S3-compatible) ─────────────────────
MINIO_ENDPOINT_URL=http://89.58.44.97:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=hydraulic

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airflow

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Prometheus ────────────────────────────────────────────────
PROMETHEUS_RETENTION=30d

# ── Chemins donnees (inside containers) ───────────────────────
RAW_DIR=data/raw
RAW_CSV_PATH=data/raw/hydraulic_data.csv
PROCESSED_CSV_PATH=data/processed/hydraulic_clean.csv
INPUT_PATH=data/processed/hydraulic_clean.csv

# ── Hyperparametres modele ────────────────────────────────────
N_ESTIMATORS=100
TEST_SIZE=0.2
RANDOM_STATE=42
